# ---------------------------------------------------------------------------
# Vulnerable Notes API — example environment
#
# Copy this file to `.env` before starting the lab:
#     cp .env.example .env
#
# Every value here is a throwaway LAB value. Nothing in this repository is a
# real credential, and nothing here should ever be reused outside the lab.
# ---------------------------------------------------------------------------

# SQLite database file used by Prisma. Created locally by `pnpm db:reset`.
DATABASE_URL="file:./dev.db"

# Secret used to sign lab JWTs. Obviously fake, and long enough to pass the
# 32-character minimum the app enforces at startup. Generate a real one with
# `openssl rand -base64 48` in an actual project, and never commit it.
JWT_SECRET="lab-only-not-a-real-secret-please-change-me-0000"

# How long an issued lab token stays valid.
JWT_EXPIRES_IN="1h"

# bcrypt work factor. 12 is a sane default for real apps; the test suite drops
# this to 4 so the suite stays fast.
BCRYPT_COST=12

# HTTP port and bind address. The lab binds to loopback on purpose so the
# vulnerable API is not reachable from anywhere else on your network.
PORT=3000
HOST="127.0.0.1"

# "development", "test" or "production". The app refuses to start when
# NODE_ENV=production is combined with LAB_MODE=vulnerable.
NODE_ENV="development"
