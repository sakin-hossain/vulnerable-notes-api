{
  "name": "vulnerable-notes-api",
  "version": "1.0.0",
  "private": true,
  "description": "An intentionally vulnerable Node.js + TypeScript API for teaching application security to developers. Educational use only — never deploy publicly.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma db push && pnpm db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab:vulnerable": "cross-env LAB_MODE=vulnerable tsx watch src/server.ts",
    "lab:secure": "cross-env LAB_MODE=secure tsx watch src/server.ts",
    "db:nuke": "node -e \"require('fs').rmSync('prisma/dev.db',{force:true})\" && pnpm db:reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "bcrypt",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "superagent": "10.3.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.2",
    "@types/supertest": "6.0.3",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
